programa
{
	
	funcao inicio()
	{
		inteiro n1,resposta
		escreva("Number One:")
		leia(n1)
		resposta = multiplicacao(n1)
		escreva("\nResposta Correta:",resposta)		
	}
	funcao inteiro multiplicacao(inteiro n){
	  inteiro resultado
	  resultado = n*10
	  retorne resultado
	  
	}  
}

programa {
  funcao inicio() {
    real primeiro,segundo,notas,media
    

    escreva("Média da turma:")
    leia(media)
    escreva("Primeira media do Aluno:")
    leia(primeiro)
    escreva("Segunda media do Aluno:")
    leia(segundo)

    notas = (primeiro * segundo)/2

    escreva("Média Total:" ,(primeiro+media)/2,"\n")
    escreva("Média Total:" ,(segundo+media)/2,"\n")






    
  }
}

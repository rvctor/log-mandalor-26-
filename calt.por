programa {
  funcao inicio() {
    inteiro soma1,soma2, soma3, subtracao1,subtracao2, subtracao3, multiplicacao1,multiplicacao2, multiplicacao3, num1, num2, num3, total

    escreva("Digite o número:")
    leia(num1)
    escreva("Digite o número:")
    leia(num2)
    escreva("Digite o número:")
    leia(num3)

    soma1= num1+num3 
    soma2= num2+num3
    soma3= num2+num1

    subtracao1=num1-num2
    subtracao2=num3-num1
    subtracao3=num2-num3 



    escreva("\nSoma= ",soma1)
    escreva("\nSoma= ",soma2)
    escreva("\nSoma= ",soma3)
    escreva("\nSubtração= ",subtracao1)
    escreva("\nSubtração= ",subtracao2)
    escreva("\nSubtração= ",subtracao3)



  }
}

programa
{
	
	funcao inicio()
	{
		inteiro numero
		escreva("Digite o nº:")
		leia(numero)
		escreva("Resposta:",multiplicacao(numero))
	}

	funcao inteiro multiplicacao(inteiro numero){
		retorne numero * 10
	}
}

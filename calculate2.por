programa
{
	
	funcao inicio()
	{
		inteiro n1,n2,resposta
		escreva("Number One:")
		leia(n1)
		escreva("Number Two:")
		leia(n2)
		resposta = soma(n1,n2)
		escreva("\nResposta Correta:",resposta)
		
	}
	funcao inteiro soma(inteiro a, inteiro b){
	  inteiro resultado
	  resultado = a+b
	  retorne resultado
	  
	}  
}


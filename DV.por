programa
{
	
	funcao inicio()
	{
		inteiro n1
		escreva("Algoritmo:")
		leia(n1)
		divisao(n1/2)
		
	}
	funcao divisao(inteiro a){
	  escreva("\nTotal:",a)
	}  
}


programa {
  funcao inicio() {
    cadeia nome="Alguém"
    inteiro numero
    inteiro primeiro
    inteiro segundo

    escreva("Digite o seu nome completo:")
    leia(nome)

    escreva("Informe a primeiro média do aluno:")
    leia(primeiro)
    escreva("Informe a segundo média do aluno:")
    leia(segundo)
    
    escreva("media:" ,(primeiro+segundo)/2,"\n")


    
  }
}

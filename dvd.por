programa {
  funcao inicio() {
    real dividendo, divisor, quociente, resto, resultado

    escreva("Dividendo:")
    leia(dividendo)
    escreva("Divisor:")
    leia(divisor)
    

    escreva("Total:" ,dividendo/divisor,"\n")


    escreva("Quociente:")
    leia(quociente)
    escreva("Quociente:" ,dividendo/divisor,"\n")
    //escreva("Resto:")
    //leia(resto)
    //Copilot said:

//Na divisão, temos:

//Dividendo: número que será dividido.
//Divisor: número pelo qual vamos dividir.
//Quociente: resultado da divisão.
//Resto: o que sobra da divisão.
//Exemplo: 17 ÷ 5 = 3 e sobra 2


  }
}

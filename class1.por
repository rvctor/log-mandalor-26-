programa
{
	// Escrever um algoritimo que calcule o salario final de um vendedor, mostre o slario fixo, o valor de vendas
    //e o salario final incluindo a comissao sobre as vendas do me
	funcao inicio()
	{
		inteiro n1,n2,n3
		escreva("Nome do vendedor:")
		leia(n1)
		escreva("Salário:")
		leia(n2)
		escreva("Valor total de vendas:")
		leia(n3)

	}
	funcao multipicacao(inteiro n3){
	  escreva("\nSoma:",n3*10)}
	  
	 funcao divisao(inteiro n3){
	  	escreva("\nTotal:",n3/100)
	 }
}


programa
{
	
	funcao inicio()
	{
		inteiro n1,n2
		escreva("Number One:")
		leia(n1)
		escreva("Number Two:")
		leia(n2)
		soma(n1,n2)
	}
	funcao soma(inteiro a, inteiro b){
	  escreva("\nSoma:",a+b)
	}  
}

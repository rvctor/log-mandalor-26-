programa {
  funcao inicio() {

    inteiro primeiro 
    inteiro segundo
    inteiro terceiro
    inteiro quarto

    escreva("Digte primeiro numero:")
    leia(primeiro)

    escreva("Digite segundo numero:")
    leia(segundo)

    escreva("Digite terceiro numero:")
    leia(terceiro)

    escreva("Digite quarto numero:")
    leia(quarto)

    escreva("Soma:" ,primeiro+segundo+terceiro+quarto,"\n")
    escreva("Subtracao:" ,primeiro-segundo-terceiro-quarto,"\n")
    escreva("Multiplicacao:" ,primeiro*segundo*terceiro*quarto,"\n")
    escreva("Divisao:" ,primeiro/segundo/terceiro/quarto,"\n")
    escreva("Resto da Divisao:", primeiro%segundo&terceiro%quarto,"\n")  

    escreva("Soma, Subtracao:" ,primeiro+segundo-terceiro-quarto+primeiro,"\n")
    
    
  }
}
